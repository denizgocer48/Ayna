{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "APP_VARIANT": "development" },
      "ios": { "simulator": true }
    },
    "preview": {
      "distribution": "internal",
      "env": { "APP_VARIANT": "preview" },
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "env": { "APP_VARIANT": "production" },
      "channel": "production"
    }
  },
  "submit": {
    "production": {}
  }
}
